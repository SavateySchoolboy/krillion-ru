{
  "manifest_version": 3,
  "name": "Krillion по-русски",
  "version": "1.0.0",
  "description": "Русский интерфейс Krillion и перевод ответов на английский прямо в Chrome.",
  "minimum_chrome_version": "138",
  "content_scripts": [
    {
      "matches": [
        "https://krillion.io/*",
        "https://www.krillion.io/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
